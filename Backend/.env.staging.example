# WorkBridge — STAGING environment skeleton (Phase 2 deliverable, plan §2 item 8)
# --------------------------------------------------------------------
# Rule (§27/§31): LOCAL never deploys; STAGING is disposable but production-
# shaped; PROD lives ONLY in the deployment platform's secret manager (never in
# git, never in a .env committed anywhere — root .gitignore excludes .env*).
#
# This file documents the staging contract; copy to Backend/.env.staging on the
# staging host (or mount as secrets) — it is a TEMPLATE, not live values.
# --------------------------------------------------------------------
NODE_ENV=staging
PORT=3000
DATABASE_URL=mysql://staging_user:CHANGE_ME@mysql.staging.internal:3306/workbridge_staging?connection_limit=10
CORS_ORIGINS=https://staging.workbridge.example,https://admin.staging.workbridge.example
# SMS (provider decision pending — §36a #12; adapter interface only until closed)
SMS_PROVIDER=stub
SMS_API_KEY=CHANGE_ME
# Push (provider decision pending — §36a #17)
PUSH_PROVIDER=stub
PUSH_KEY=CHANGE_ME
# Private object storage for KYC docs / evidence (decision pending — §36a #14)
STORAGE_ENDPOINT=https://staging-storage.internal
STORAGE_BUCKET=workbridge-staging-private
STORAGE_KEY=CHANGE_ME
# Secrets
JWT_ACCESS_SECRET=CHANGE_ME
# Observability (§28): staging ships WITHOUT legacy callbacks (404 them)
ENABLE_LEGACY_CALLBACKS=false
RATE_LIMIT_ENABLED=true
