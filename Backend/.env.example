# Backend environment template — copy to `.env` for local development. NEVER commit `.env`.
# Loaded by @nestjs/config (app boot, fail-fast validation) and by prisma7.config.ts (Prisma CLI).

NODE_ENV=development
PORT=3000

# Allowed browser origins (comma separated) — dev tooling / future admin web app
CORS_ORIGINS=http://localhost:8081,http://localhost:8080,http://localhost:19006

# MySQL connection — Wave 1 (Phase 4): local MySQL 8.4 instance on port 3307
# (XAMPP/MariaDB owns 3306 on this machine; see Documentation/audit.md).
DATABASE_URL="mysql://root:@127.0.0.1:3307/workbridge_dev"

# Access-token secret (HS256) — 64 hex chars, generate: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# OTP behaviour: true = codes logged to backend console + returned in dev responses
# (simulated SMS). NEVER true in production.
OTP_SIM=true
KYC_ID_SECRET=
ADMIN_PHONES=

# Server-signed rotating QR payloads (attendance §19) — any long random string
ATTENDANCE_TOKEN_SECRET=change-me
