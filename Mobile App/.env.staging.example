# WorkBridge mobile — STAGING env skeleton (Phase 2 deliverable)
# Expo reads EXPO_PUBLIC_* at build time; API_URL targets the staging gateway.
# PROD values ship via EAS environment config — never committed (root .gitignore).
EXPO_PUBLIC_API_URL=https://api.staging.workbridge.example/api/v1
EXPO_PUBLIC_ENV=staging
EXPO_PUBLIC_OTP_SIM_MODE=false
